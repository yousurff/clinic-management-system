@{ Layout = null; ViewData["Title"] = "Klinik Yönetim Sistemi"; }
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Klinik Yönetim Sistemi</title>
    <script>(function(){var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="landing">
    <header class="landing-nav">
        <div class="landing-brand"><i class="bi bi-heart-pulse"></i> Klinik YS</div>
        <div class="landing-actions">
            <button class="icon-btn" title="Tema" onclick="(function(){var r=document.documentElement;var n=r.getAttribute('data-theme')==='dark'?'light':'dark';r.setAttribute('data-theme',n);localStorage.setItem('theme',n);})()"><i class="bi bi-moon-stars"></i></button>
            <a class="btn btn-secondary" asp-controller="Account" asp-action="Login">Giriş Yap</a>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
        </div>
    </header>

    <section class="landing-hero">
        <h1>Sağlığınız için modern klinik yönetimi</h1>
        <p>Randevularınızı kolayca alın, takip edin ve yönetin. Doktorlarımız ve bölümlerimizle hızlı, güvenli ve dijital bir deneyim.</p>
        <div class="landing-cta">
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Hemen Kayıt Ol</a>
            <a class="btn btn-secondary" asp-controller="Account" asp-action="Login">Giriş Yap</a>
        </div>
    </section>

    <section class="landing-features">
        <div class="landing-feature"><i class="bi bi-calendar-check"></i><h3>Kolay Randevu</h3><p>Birkaç tıkla istediğin bölüm ve doktordan randevu al.</p></div>
        <div class="landing-feature"><i class="bi bi-clock-history"></i><h3>Geçmiş Takibi</h3><p>Tüm randevularını ve durumlarını tek ekrandan izle.</p></div>
        <div class="landing-feature"><i class="bi bi-shield-check"></i><h3>Güvenli</h3><p>Verilerin güvenli şekilde saklanır, gizliliğin korunur.</p></div>
    </section>
</div>
</body>
</html>