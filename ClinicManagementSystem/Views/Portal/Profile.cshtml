@model ClinicManagementSystem.Models.Patient
@{ ViewData["Title"] = "Profilim"; }

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <h2>Profilim</h2>
        @if (ViewBag.Message != null) { <div class="auth-error" style="background:#dcfce7;color:#15803d;">@ViewBag.Message</div> }

        <!-- Görüntüleme modu -->
        <div id="viewMode">
            <dl class="profile-info">
                <dt>Ad</dt><dd>@Model.FirstName</dd>
                <dt>Soyad</dt><dd>@Model.LastName</dd>
                <dt>Telefon</dt><dd>@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</dd>
                <dt>Doğum Tarihi</dt><dd>@(Model.BirthDate?.ToString("dd.MM.yyyy") ?? "—")</dd>
            </dl>
            <button type="button" class="btn btn-primary"
                    onclick="document.getElementById('viewMode').style.display='none';document.getElementById('editMode').style.display='block';">
                <i class="bi bi-pencil"></i> Bilgileri Güncelle
            </button>
        </div>

        <!-- Düzenleme modu (başta gizli) -->
        <div id="editMode" style="display:none;">
            <form asp-action="Profile" method="post">
                <div class="mb-3">
                    <label class="form-label">Ad</label>
                    <input name="firstName" value="@Model.FirstName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Soyad</label>
                    <input name="lastName" value="@Model.LastName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Telefon</label>
                    <input name="phone" value="@Model.Phone" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Doğum Tarihi</label>
                    <input name="birthDate" type="date" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <button type="button" class="btn btn-secondary"
                        onclick="document.getElementById('editMode').style.display='none';document.getElementById('viewMode').style.display='block';">İptal</button>
            </form>
        </div>
    </div>
</div>