@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => ctrl == c ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Klinik Yönetim Sistemi</title>
    <script>(function(){var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand"><i class="bi bi-heart-pulse"></i><span>Klinik YS</span></div>
        <nav class="sidebar-nav">
            @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
            {
                <a class="nav-link-item @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                <a class="nav-link-item @Active("Patients")" asp-controller="Patients" asp-action="Index"><i class="bi bi-people"></i><span>Hastalar</span></a>
                <a class="nav-link-item @Active("Doctors")" asp-controller="Doctors" asp-action="Index"><i class="bi bi-person-badge"></i><span>Doktorlar</span></a>
                <a class="nav-link-item @Active("Departments")" asp-controller="Departments" asp-action="Index"><i class="bi bi-building"></i><span>Bölümler</span></a>
                <a class="nav-link-item @Active("Appointments")" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-check"></i><span>Randevular</span></a>
                <a class="nav-link-item @Active("Reports")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i><span>Raporlar</span></a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link-item @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-shield-lock"></i><span>Kullanıcılar</span></a>
                }
            }
            @if (User.IsInRole("Patient"))
            {
                <a class="nav-link-item @Active("Portal")" asp-controller="Portal" asp-action="Index"><i class="bi bi-calendar-check"></i><span>Randevularım</span></a>
                <a class="nav-link-item" asp-controller="Portal" asp-action="Book"><i class="bi bi-plus-circle"></i><span>Randevu Al</span></a>
            }
        </nav>
    </aside>
    <div class="main">
        <header class="topbar">
            <button class="icon-btn" id="sidebarToggle"><i class="bi bi-list"></i></button>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <div class="topbar-actions">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="topbar-user"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        <button type="submit" class="icon-btn" title="Çıkış"><i class="bi bi-box-arrow-right"></i></button>
                        <a class="icon-btn" asp-controller="Settings" asp-action="Index" title="Ayarlar"><i class="bi bi-gear"></i></a>
                    </form>
                }
                <button class="icon-btn" id="themeToggle" title="Tema değiştir"><i class="bi bi-moon-stars"></i></button>
            </div>
        </header>
        <main class="content">
            @RenderBody()
        </main>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>