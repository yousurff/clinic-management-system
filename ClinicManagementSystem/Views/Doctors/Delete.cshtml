@model ClinicManagementSystem.Models.Doctor
@{ ViewData["Title"] = "Doktor Sil"; }

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <h2>Bu doktoru silmek istediğine emin misin?</h2>
        <dl class="row">
            <dt class="col-sm-3">Ad Soyad</dt><dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>
            <dt class="col-sm-3">Bölüm</dt><dd class="col-sm-9">@Model.Department?.Name</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="DoctorID" />
            <button type="submit" class="btn btn-danger">Sil</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>