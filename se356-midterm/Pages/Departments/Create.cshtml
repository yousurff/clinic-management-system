@page
@model se356_midterm.Pages.Departments.CreateModel
@{
    ViewData["Title"] = "Add New Department";
}

<div class="container mt-4">
    <h2>Add New Department</h2>

    @if (Model.errorMessage.Length > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @Model.errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="POST">
        <div class="row mb-3 mt-4">
            <label class="col-sm-2 col-form-label">Department Name</label>
            <div class="col-sm-6">
                <input type="text" class="form-control" name="departmentName" value="@Model.departmentInfo.DepartmentName" placeholder="e.g., Cardiology" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="offset-sm-2 col-sm-3 d-grid">
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
            <div class="col-sm-3 d-grid">
                <a class="btn btn-outline-secondary" href="/Departments/Index" role="button">Cancel</a>
            </div>
        </div>
    </form>
</div>