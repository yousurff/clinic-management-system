@page
@model se356_midterm.Pages.Doctors.CreateModel
@{
    ViewData["Title"] = "Add New Doctor";
}

<div class="container mt-4">
    <h2>Add New Doctor</h2>

    @if (Model.errorMessage.Length > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @Model.errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="POST">
        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input type="text" class="form-control" name="firstName" value="@Model.doctorInfo.FirstName">
        </div>
        <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input type="text" class="form-control" name="lastName" value="@Model.doctorInfo.LastName">
        </div>
        
        <div class="mb-3">
            <label class="form-label">Department</label>
            <select class="form-select" name="departmentID">
                <option value="">-- Select Department --</option>
                @foreach (var dept in Model.listDepartments)
                {
                    <option value="@dept.DepartmentID" selected="@(dept.DepartmentID == Model.doctorInfo.DepartmentID)">
                        @dept.DepartmentName
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" href="/Doctors/Index">Cancel</a>
    </form>
</div>