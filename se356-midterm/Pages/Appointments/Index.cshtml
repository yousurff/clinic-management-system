@page
@model se356_midterm.Pages.Appointments.IndexModel
@{
    ViewData["Title"] = "Appointments";
}

<div class="container mt-4">
    <h2>Appointments</h2>
    <a class="btn btn-primary mb-3" href="/Appointments/Create">Create New Appointment</a>
    
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Date and Time</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.listAppointments)
        {
            <tr>
                <td>@item.AppointmentID</td>
                <td>@item.PatientName</td>
                <td>@item.DoctorName</td>
                <td>@item.AppointmentDate</td>
            </tr>
        }
        </tbody>
    </table>
</div>