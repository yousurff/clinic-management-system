@page
@model se356_midterm.Pages.Patients.EditModel
@{
    ViewData["Title"] = "Hasta Düzenle";
}

<div class="container mt-4">
    <h2>Edit Patient Info</h2>

    @if (Model.errorMessage.Length > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Hata!</strong> @Model.errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="POST">
        <input type="hidden" name="id" value="@Model.patientInfo.PatientID" />
        
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="firstName" value="@Model.patientInfo.FirstName">
        </div>
        <div class="mb-3">
            <label class="form-label">Surname</label>
            <input type="text" class="form-control" name="lastName" value="@Model.patientInfo.LastName">
        </div>
        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input type="text" class="form-control" name="phone" value="@Model.patientInfo.Phone">
        </div>
        <div class="mb-3">
            <label class="form-label">Birthday</label>
            <input type="date" class="form-control" name="birthDate" value="@Model.patientInfo.BirthDate">
        </div>

        <button type="submit" class="btn btn-primary">Update</button>
        <a class="btn btn-outline-secondary" href="/Patients/Index">İptal</a>
    </form>
</div>