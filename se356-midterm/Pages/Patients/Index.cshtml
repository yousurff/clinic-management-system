@page
@model se356_midterm.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Patients";
}

<div class="container mt-4">
    <h2>Patients</h2>
    <a class="btn btn-primary mb-3" href="/Patients/Create">Add New Patient</a>
    
    <table class="table table-bordered table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Phone</th>
            <th>Birth Date</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.listPatients)
        {
            <tr>
                <td>@item.PatientID</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Phone</td>
                <td>@item.BirthDate</td>
                <td>
                    <a class="btn btn-sm btn-warning" href="/Patients/Edit?id=@item.PatientID">Edit</a>
                    <a class="btn btn-sm btn-danger" href="/Patients/Delete?id=@item.PatientID">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>